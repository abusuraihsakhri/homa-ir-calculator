{
  "openapi": "3.1.0",
  "info": {
    "title": "HOMA1 Calculator and Demonstration API",
    "description": "HOMA1 arithmetic and optional generic demonstration agent workflows. No independently validated clinical interpretation.",
    "version": "3.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Application process health metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON summary of in-memory dossier and audit counts"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return a local mock supervisory response (not an LLM)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/homa": {
      "post": {
        "summary": "Calculate HOMA1 indices from fasting glucose and insulin",
        "description": "Supply glucose in mmol/L or mg/dL and insulin in µU/mL; output is not a clinical diagnosis.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "glucose_mmol": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Use this or glucose_mgdl"
                  },
                  "glucose_mgdl": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Use this or glucose_mmol"
                  },
                  "insulin_mu_u_ml": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "insulin_mu_u_ml"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HOMA1-IR and HOMA1-%B (nullable when glucose ≤ 3.5 mmol/L)"
          },
          "422": {
            "description": "Invalid or missing inputs"
          }
        }
      }
    }
  }
}
